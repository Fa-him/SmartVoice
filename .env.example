# Copy this file to .env and fill in your real values.
# Do not commit .env.

CohereAPIKey=your_cohere_api_key
GroqAPIKey=your_groq_api_key
SerperAPIkey=your_serper_api_key
HuggingFaceAPIKey=your_huggingface_api_key
HuggingFaceImageModel=black-forest-labs/FLUX.1-schnell
HuggingFaceProvider=auto
HuggingFaceImageTimeoutSeconds=90
HuggingFaceImagesPerPrompt=1

Username=Your Name
Assistantname=SmartVoice
InputLanguage=bn-BD
AssistantVoice=en-CA-LiamNeural

# Speech recognition options
SpeechRecognitionTimeoutSeconds=20
SpeechRecognitionPollSeconds=0.2
SpeechRecognitionHeadless=False
SpeechRecognitionAutoGrantMic=True
SpeechRecognitionUseFakeMic=False
